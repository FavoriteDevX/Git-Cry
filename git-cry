def is_git_repository():
    """Checks if the current directory is inside a Git repository."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--is-inside-work-tree"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        return result.returncode == 0
    except FileNotFoundError:
        print("[ERROR] Git is not installed on this system.")
        sys.exit(1)

def has_merge_conflicts():
    """Checks if there are unresolved merge conflicts in the repository."""
    try:
        # 'git diff --name-only --diff-filter=U' lists unmerged (conflicted) files
        result = subprocess.run(
            ["git", "diff", "--name-only", "--diff-filter=U"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=True
        )
        conflicted_files = result.stdout.strip().split("\n")
        return [f for f in conflicted_files if f]
    except subprocess.CalledProcessError:
        return []

def main():
    if not is_git_repository():
        print("❌ This is not a git repository. You can't cry here (well, you can, but git won't track it).")
